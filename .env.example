# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy this file to '.env' and populate with your production or local secrets.
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.
# ==============================================================================

# Database Settings (MySQL / AWS RDS)
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=todo_db
MYSQL_USER=todouser
MYSQL_PASSWORD=your_secure_password_here
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/todo_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=todouser
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# Third-Party API Keys & Integrations
COHERE_API_KEY=your_cohere_api_key_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Frontend & CORS Settings
REACT_APP_API_BASE_URL=http://localhost:8080/api/todos
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost

# Container Registry & CI/CD Pipeline
DOCKER_HUB_USERNAME=your_dockerhub_username
DOCKER_HUB_TOKEN=your_dockerhub_access_token
IMAGE_TAG=latest

# AWS Deployment Credentials / Hosts
AWS_REGION=us-east-1
EC2_HOST=your-ec2-public-ip-or-dns
EC2_SSH_KEY=your_ssh_private_key_content
RDS_ENDPOINT=your-rds-instance.xxx.us-east-1.rds.amazonaws.com

# Monitoring & Dashboard Auth
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_grafana_admin_password